# ==============================================================================
# Mahalaxmi Kirana Store — Environment Configuration Template (.env.example)
# Copy this file to .env and provide your deployment-specific credentials.
# NEVER commit the active .env file or real credentials to source control!
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000

# MongoDB Database Connection
# Production / Development URI:
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mahalaxmi_kirana?retryWrites=true&w=majority
# Dedicated Isolated Test Database URI (Mandatory for running test suites safely):
MONGODB_URI_TEST=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mahalaxmi_kirana_test?retryWrites=true&w=majority

# Authentication & Security
# MUST be a cryptographically secure random string >= 32 characters:
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long

# Store Owner Initial Account (Used by: npm run seed:owner)
OWNER_NAME=Mahalaxmi Kirana Owner
OWNER_PHONE=9860924504
OWNER_PASSWORD=replace_with_a_secure_owner_password_8_to_72_chars

# Cloudinary Media Storage (Catalog product image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# AI Order Box & Smart Substitution (R3)
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Offsite Backup Storage (Optional: S3 / Backblaze B2 compatible)
B2_BUCKET_NAME=your_backup_bucket
B2_ENDPOINT=https://s3.us-west-000.backblazeb2.com
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_app_key
